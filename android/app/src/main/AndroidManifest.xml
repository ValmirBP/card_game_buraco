<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- usesCleartextTraffic: o modo Online conecta num servidor LAN comum
         (ws://IP:3001, sem TLS). Desde a API 28 o Android bloqueia por
         padrao QUALQUER trafego de rede nao criptografado (camada distinta
         da politica de mixed-content da pagina, ja tratada via
         capacitor.config.ts server.androidScheme) - sem isso, a conexao
         WebSocket falha silenciosamente (fecha logo apos abrir) mesmo com
         o servidor no ar e a porta acessivel. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|layoutDirection|colorMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CAMERA: leitor de QR da tela Online (src/components/Online/QrScanner.tsx),
         que usa getUserMedia + BarcodeDetector dentro do próprio WebView (sem
         plugin nativo). A página carrega de http://localhost (ver
         capacitor.config.ts androidScheme), que conta como contexto seguro,
         então a câmera é permitida - mas só se a permissão estiver declarada
         aqui. `required=false` pra o app continuar instalável num aparelho
         sem câmera (lá o botão "Escanear QR" simplesmente não aparece). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
